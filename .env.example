# Copy this file to .env and fill in real values. Never commit .env.
AMAZON_ADS_EMAIL=you@example.com
AMAZON_ADS_PASSWORD=change-me
# The secret behind your authenticator app QR code (base32 string), NOT a 6-digit code.
# Amazon shows this once when you enable 2-Step Verification with an authenticator app
# ("Can't scan the barcode?" / "enter this key manually" link during setup).
AMAZON_ADS_TOTP_SECRET=BASE32SECRETHERE

# Regional advertising console base URL. Common values:
#   https://advertising.amazon.com   (US/global)
#   https://advertising.amazon.co.uk
#   https://advertising.amazon.in
AMAZON_ADS_BASE_URL=https://advertising.amazon.com

# Set to "false" to watch the browser while debugging login issues.
HEADLESS=true

# --- export_account.py: which client account to pull data for. If
# TARGET_ENTITY_ID is known (printed by a prior run's URL) it's used
# directly. Otherwise the script searches TARGET_ACCOUNT_NAME by name.
# TARGET_COUNTRY_CODE picks which regional login domain to use (in, us,
# uk, ...) — each gets its own saved session (storage_state_<code>.json),
# and logging in directly on the right country avoids a flaky mid-session
# cross-region switch.
TARGET_COUNTRY_CODE=in
TARGET_ACCOUNT_NAME=Campus
TARGET_ENTITY_ID=

# Date range to pull. TARGET_DATE_MONTHS_BACK=1 shows last month (left
# calendar) and this month (right calendar) side by side in the picker.
# Set TARGET_DATE_END_IN_NEXT_MONTH=true when the range spans both, e.g.
# 23 Aug - 22 Sep (day_start in the left/earlier month, day_end in the right).
TARGET_DATE_DAY_START=1
TARGET_DATE_DAY_END=31
TARGET_DATE_MONTHS_BACK=1
TARGET_DATE_END_IN_NEXT_MONTH=false

# --- Hector (app.hectorai.live) — no 2FA, just email + password.
HECTOR_EMAIL=you@example.com
HECTOR_PASSWORD=change-me
HECTOR_BASE_URL=https://app.hectorai.live
